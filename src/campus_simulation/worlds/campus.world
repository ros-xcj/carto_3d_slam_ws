<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="campus_world">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Zone A: Teaching Area -->
    <model name="zone_a_wall_1">
      <pose>0 10 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>20 0.2 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>20 0.2 2</size></box>
          </geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient></material>
        </visual>
      </link>
      <static>true</static>
    </model>
    
    <model name="zone_a_wall_2">
      <pose>-10 0 1 0 0 1.570796</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>20 0.2 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>20 0.2 2</size></box>
          </geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient></material>
        </visual>
      </link>
      <static>true</static>
    </model>

    <!-- Zone B: Dormitory Area -->
    <model name="zone_b_wall_1">
      <pose>20 0 1 0 0 1.570796</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>20 0.2 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>20 0.2 2</size></box>
          </geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient></material>
        </visual>
      </link>
      <static>true</static>
    </model>

    <model name="zone_b_wall_2">
      <pose>10 -10 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>20 0.2 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>20 0.2 2</size></box>
          </geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient></material>
        </visual>
      </link>
      <static>true</static>
    </model>

    <!-- Passageway Wall -->
    <model name="passageway_wall">
      <pose>5 5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>10 0.2 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>10 0.2 2</size></box>
          </geometry>
          <material><ambient>0.1 0.1 0.8 1</ambient></material>
        </visual>
      </link>
      <static>true</static>
    </model>
    
    <!-- Obstacle in Zone A -->
    <model name="obstacle_a">
      <pose>-5 5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>1.0</radius><length>1.0</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>1.0</radius><length>1.0</length></cylinder>
          </geometry>
        </visual>
      </link>
      <static>true</static>
    </model>

    <!-- Obstacle in Zone B -->
    <model name="obstacle_b">
      <pose>15 -5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>2 2 1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>2 2 1</size></box>
          </geometry>
        </visual>
      </link>
      <static>true</static>
    </model>

  </world>
</sdf>
