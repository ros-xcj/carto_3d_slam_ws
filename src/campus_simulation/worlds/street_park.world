<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="street_park_world">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Street -->
    <model name="street">
      <pose>0 0 0.005 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>100 8 0.01</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>100 8 0.01</size></box>
          </geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Grass North -->
    <model name="grass_north">
      <pose>0 14 0.005 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>100 20 0.01</size></box>
