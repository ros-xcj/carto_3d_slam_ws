<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="indoor_outdoor_campus">
    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Base Ground Plane with Grass -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grass</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Asphalt Road (Outdoor) -->
    <model name="asphalt_road">
      <static>true</static>
      <pose>0 -5 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>100 8 0.01</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Asphalt</name>
            </script>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>100 8 0.01</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Trees (Outdoor) -->
    <include>
      <uri>model://pine_tree</uri>
      <name>pine_tree_1</name>
      <pose>-8 -2 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://pine_tree</uri>
      <name>pine_tree_2</name>
      <pose>8 -2 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://oak_tree</uri>
      <name>oak_tree_1</name>
      <pose>-10 -8 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://oak_tree</uri>
      <name>oak_tree_2</name>
      <pose>10 -8 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://pine_tree</uri>
      <name>pine_tree_3</name>
      <pose>-15 -5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://pine_tree</uri>
      <name>pine_tree_4</name>
      <pose>15 -5 0 0 0 0</pose>
    </include>

    <!-- Indoor Building Walls -->
    <model name="indoor_building">
      <pose>0 8 0 0 0 0</pose>
      <static>true</static>
      <link name="walls">
        <!-- Left Wall -->
        <collision name="left_wall_col">
          <pose>-4 0 1.25 0 0 0</pose>
          <geometry><box><size>0.2 10 2.5</size></box></geometry>
        </collision>
        <visual name="left_wall_vis">
          <pose>-4 0 1.25 0 0 0</pose>
          <geometry><box><size>0.2 10 2.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Bricks</name>
            </script>
          </material>
        </visual>
        
        <!-- Right Wall -->
        <collision name="right_wall_col">
          <pose>4 0 1.25 0 0 0</pose>
          <geometry><box><size>0.2 10 2.5</size></box></geometry>
        </collision>
        <visual name="right_wall_vis">
          <pose>4 0 1.25 0 0 0</pose>
          <geometry><box><size>0.2 10 2.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Bricks</name>
            </script>
          </material>
        </visual>
        
        <!-- Back Wall -->
        <collision name="back_wall_col">
          <pose>0 5 1.25 0 0 0</pose>
          <geometry><box><size>8.2 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="back_wall_vis">
          <pose>0 5 1.25 0 0 0</pose>
          <geometry><box><size>8.2 0.2 2.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Bricks</name>
            </script>
          </material>
        </visual>
        
        <!-- Front Wall Left -->
        <collision name="front_left_wall_col">
          <pose>-2.75 -5 1.25 0 0 0</pose>
          <geometry><box><size>2.7 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="front_left_wall_vis">
          <pose>-2.75 -5 1.25 0 0 0</pose>
          <geometry><box><size>2.7 0.2 2.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Bricks</name>
            </script>
          </material>
        </visual>
        
        <!-- Front Wall Right -->
        <collision name="front_right_wall_col">
          <pose>2.75 -5 1.25 0 0 0</pose>
          <geometry><box><size>2.7 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="front_right_wall_vis">
          <pose>2.75 -5 1.25 0 0 0</pose>
          <geometry><box><size>2.7 0.2 2.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Bricks</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Indoor Wood Floor -->
    <model name="indoor_floor">
      <static>true</static>
      <pose>0 8 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>7.8 9.8 0.01</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/WoodFloor</name>
            </script>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>7.8 9.8 0.01</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Tables (Indoor) -->
    <include>
      <uri>model://cafe_table</uri>
      <name>table_1</name>
      <pose>-2 6 0.01 0 0 0</pose>
    </include>
    <include>
      <uri>model://cafe_table</uri>
      <name>table_2</name>
      <pose>2 6 0.01 0 0 0</pose>
    </include>
    <include>
      <uri>model://table</uri>
      <name>table_3</name>
      <pose>0 11 0.01 0 0 1.5707</pose>
    </include>

    <!-- Custom Chairs (Indoor) -->
    <model name="chair_1">
      <pose>-2 5.2 0.01 0 0 0</pose>
      <static>false</static>
      <link name="link">
        <collision name="seat_collision">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>0.4 0.4 0.05</size></box></geometry>
        </collision>
        <visual name="seat_visual">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>0.4 0.4 0.05</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1.0</ambient></material>
        </visual>
        <collision name="back_collision">
          <pose>0 -0.175 0.7 0 0 0</pose>
          <geometry><box><size>0.4 0.05 0.5</size></box></geometry>
        </collision>
        <visual name="back_visual">
          <pose>0 -0.175 0.7 0 0 0</pose>
          <geometry><box><size>0.4 0.05 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1.0</ambient></material>
        </visual>
        <collision name="base_collision">
          <pose>0 0 0.225 0 0 0</pose>
          <geometry><box><size>0.3 0.3 0.45</size></box></geometry>
        </collision>
        <visual name="base_visual">
          <pose>0 0 0.225 0 0 0</pose>
          <geometry><box><size>0.3 0.3 0.45</size></box></geometry>
          <material><ambient>0.4 0.2 0.1 1.0</ambient></material>
        </visual>
        <inertial>
          <mass>3.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia>
        </inertial>
      </link>
    </model>

