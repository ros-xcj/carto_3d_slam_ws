<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="enclosed_large_world">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Wall North -->
    <model name="wall_north">
      <pose>0 25 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>50 0.5 5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>50 0.5 5</size></box>
          </geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material>
        </visual>
      </link>
      <static>true</static>
    </model>

    <!-- Wall South -->
    <model name="wall_south">
      <pose>0 -25 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>50 0.5 5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>50 0.5 5</size></box>
          </geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material>
        </visual>
      </link>
      <static>true</static>
    </model>

    <!-- Wall East -->
    <model name="wall_east">
      <pose>25 0 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.5 50 5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 50 5</size></box>
          </geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material>
        </visual>
      </link>
      <static>true</static>
    </model>

    <!-- Wall West -->
    <model name="wall_west">
      <pose>-25 0 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.5 50 5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 50 5</size></box>
          </geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material>
        </visual>
      </link>
      <static>true</static>
    </model>

    <!-- Some Inner Obstacles -->
    <model name="obstacle_1">
      <pose>10 10 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>2</radius><length>2</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>2</radius><length>2</length></cylinder>
          </geometry>
          <material><ambient>0.2 0.2 0.8 1</ambient></material>
        </visual>
      </link>
      <static>true</static>
    </model>

    <model name="obstacle_2">
      <pose>-15 -10 1.5 0 0 0.785</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>5 5 3</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>5 5 3</size></box>
          </geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient></material>
        </visual>
      </link>
      <static>true</static>
    </model>
    
    <model name="obstacle_3">
      <pose>5 -15 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>8 2 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>8 2 2</size></box>
          </geometry>
          <material><ambient>0.2 0.8 0.2 1</ambient></material>
        </visual>
      </link>
      <static>true</static>
    </model>

    <!-- 爬坡测试场地 (Ramp/Slope) -->
    <model name="ramp">
      <static>true</static>
      <!-- x y z roll pitch yaw -->
      <!-- pitch = -0.15 表示大约 8.5 度的坡度 -->
      <pose>4 0 0.4 0 -0.15 0</pose> 
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8 3 0.1</size>
            </box>
          </geometry>
          <!-- 增加摩擦力防止打滑 -->
          <surface>
            <friction>
              <ode>
                <mu>100.0</mu>
                <mu2>50.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8 3 0.1</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- 坡顶平台 -->
    <model name="platform">
      <static>true</static>
      <pose>10 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>4 3 0.1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100.0</mu>
                <mu2>50.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>4 3 0.1</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- 防止掉落的护栏 -->
    <model name="wall_1">
      <static>true</static>
      <pose>4 1.5 0.6 0 -0.15 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8 0.1 0.3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8 0.1 0.3</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="wall_2">
      <static>true</static>
      <pose>4 -1.5 0.6 0 -0.15 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8 0.1 0.3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8 0.1 0.3</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
